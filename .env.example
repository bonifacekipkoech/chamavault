# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/chamavault"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# ─── M-Pesa Daraja API ────────────────────────────────────────────────────────
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENV="sandbox"                          # "sandbox" or "production"
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_SHORTCODE="174379"                     # Paybill or till number
MPESA_PASSKEY="your-lipa-na-mpesa-passkey"

# For B2C (loan disbursements) — optional
MPESA_B2C_SHORTCODE="600000"
MPESA_INITIATOR_NAME="your-initiator-name"
MPESA_INITIATOR_PASSWORD="your-security-credential"

# ─── AWS S3 (document storage) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="chamavault-docs"
AWS_REGION="af-south-1"                      # Africa (Cape Town) — closest to Kenya

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
